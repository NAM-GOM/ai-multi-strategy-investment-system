# Optional: public data needs no credentials. Never commit the actual .env.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Public-only Binance host; account requests always use https://api.binance.com.
BINANCE_PUBLIC_BASE_URL=https://data-api.binance.vision
BINANCE_TIMEOUT_SECONDS=10
BINANCE_RECV_WINDOW_MS=5000
