[Unit]
Description=CryptoAutoTrading DEV-M05 observer (execution disabled)
Wants=crypto-market-collector.service
After=crypto-market-collector.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=crypto-observer
Group=crypto-read
WorkingDirectory=/srv/CryptoAutoTrading/releases/dev-m05
Environment=BINANCE_TESTNET_TRADING_ENABLED=OFF
Environment=BINANCE_TESTNET_AUTOMATED_ENABLED=OFF
UnsetEnvironment=BINANCE_API_KEY BINANCE_API_SECRET
ExecStartPre=/srv/CryptoAutoTrading/releases/dev-m05/scripts/m05-preflight.sh
ExecStart=/srv/CryptoAutoTrading/releases/dev-m05/scripts/m05-runtime.sh observer
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=78
TimeoutStopSec=120
KillSignal=SIGTERM
KillMode=control-group
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/CryptoAutoTrading/state/continuous-01/observer
ReadOnlyPaths=/var/lib/CryptoAutoTrading/state/testnet-e01
InaccessiblePaths=-/var/lib/CryptoAutoTrading/state/close-validation-01
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crypto-strategy-observer

[Install]
WantedBy=multi-user.target
