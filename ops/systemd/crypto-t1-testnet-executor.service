[Unit]
Description=CryptoAutoTrading DEV-E02 T1 Spot Testnet executor (OFF on startup)
Wants=crypto-market-collector.service crypto-strategy-observer.service
After=crypto-market-collector.service crypto-strategy-observer.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=crypto-executor
Group=crypto-executor
SupplementaryGroups=crypto-read
WorkingDirectory=/srv/CryptoAutoTrading/releases/dev-e02
EnvironmentFile=/etc/CryptoAutoTrading/e02-testnet.env
Environment=BINANCE_TESTNET_TRADING_ENABLED=OFF
Environment=BINANCE_TESTNET_AUTOMATED_ENABLED=OFF
UnsetEnvironment=BINANCE_API_KEY BINANCE_API_SECRET
ExecStartPre=/bin/bash /srv/CryptoAutoTrading/releases/dev-e02/scripts/e02-runtime.sh preflight
ExecStart=/bin/bash /srv/CryptoAutoTrading/releases/dev-e02/scripts/e02-runtime.sh serve
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=78
TimeoutStopSec=120
KillSignal=SIGTERM
KillMode=control-group
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/CryptoAutoTrading/state/testnet-e01 /var/lib/CryptoAutoTrading/state/e02-executor
ReadOnlyPaths=/var/lib/CryptoAutoTrading/state/continuous-01 /etc/CryptoAutoTrading/m05-acceptance.json
InaccessiblePaths=-/var/lib/CryptoAutoTrading/state/close-validation-01
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crypto-t1-testnet-executor

[Install]
WantedBy=multi-user.target
